# ==============================================================================
# Van Vibes Customer Frontend — Environment Configuration Template (.env.example)
# ==============================================================================

# Application Branding & Metadata
NEXT_PUBLIC_APP_NAME="Van Vibes Cafe & Restro"
NEXT_PUBLIC_APP_TAGLINE="Taste the Vibe"
NEXT_PUBLIC_APP_DESCRIPTION="A vibrant cafe and restro serving delicious food, refreshing drinks, and memorable moments in a warm and welcoming atmosphere."

# Public Customer Frontend Base URL
# Leave empty ("") for automatic VPS IP / domain detection in the browser.
# Set only if using a fixed custom domain (e.g. "https://menu.vaanvibes.cafe")
NEXT_PUBLIC_APP_URL=""

# Backend REST API Integration (FastAPI Port: 9000)
# In browser, automatically matches the current server IP/domain on port 9000.
NEXT_PUBLIC_API_URL="http://localhost:9000/api/v1"
FASTAPI_BACKEND_URL="http://127.0.0.1:9000"

# Live WebSocket Stream URL (FastAPI Port: 9000)
# In browser, automatically matches ws:// (or wss:// on HTTPS) on the current server IP/domain.
NEXT_PUBLIC_WS_URL="ws://localhost:9000/api/v1/ws/orders"

# Server Port & Binding (Customer Frontend Port: 4000)
PORT=4000
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# Department & Contact Emails
NEXT_PUBLIC_CONTACT_EMAIL="contact@cosmosnexusinnovations.com"
NEXT_PUBLIC_CAREERS_EMAIL="careers@cosmosnexusinnovations.com"
NEXT_PUBLIC_SECURITY_EMAIL="security@cosmosnexusinnovations.com"

# Social Media & External Handles
NEXT_PUBLIC_GITHUB_URL="https://github.com/PATELPRATHAM007"
NEXT_PUBLIC_TWITTER_URL="https://x.com"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com"
NEXT_PUBLIC_DISCORD_URL="https://discord.com"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_CONSOLE=true
